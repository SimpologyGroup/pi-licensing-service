# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=pi_licensing
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost

# Signing keys: folder of <kid>.pem files (manage.py generate_signing_key) and the one used for new certificates.
SIGNING_KEYS_DIR=keys
SIGNING_KID=
LICENSE_GRACE_DAYS=7
LICENSE_CHECK_HOURS=6
FREE_LICENSE_DAYS=365

# Store and Paddle payments (leave PADDLE_CLIENT_TOKEN empty to show the store as "Coming soon")
PADDLE_ENV=sandbox
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
STORE_SUPPORT_EMAIL=support@performanceinsight.co.za

# Email for licence emails (without EMAIL_HOST they are printed to the console)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=support@performanceinsight.co.za
